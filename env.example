# --- Elasticsearch ---
ELASTIC_URL=http://localhost:9200
# Railway TCP proxy to ES (when *.railway.internal always times out): set ELASTIC_URL=http://host:port and:
# ELASTIC_RAILWAY_TCP_PROXY=1
ELASTIC_RAILWAY_TCP_PROXY=
ELASTIC_API_KEY=
ELASTIC_USER=
ELASTIC_PASSWORD=

# --- Embeddings & LLM ---
JINA_API_KEY=
OPENAI_API_KEY=

# --- API server ---
PORT=8000
GATEWAY_PORT=8000
# Docker full stack: compose sets ELASTIC_URL=http://elasticsearch:9200 (overrides localhost above).

# Comma-separated origins for browser (add your Vercel URL in production)
ALLOWED_ORIGINS=

# Vercel previews: API allows https://*.vercel.app by default in code (set ALLOW_VERCEL_CORS_REGEX=0 to turn off)
# ALLOW_VERCEL_CORS_REGEX=0

# --- Optional: ElevenLabs TTS ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- FHIR (live ingest; synthetic demo uses local JSON) ---
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_TOKEN=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
